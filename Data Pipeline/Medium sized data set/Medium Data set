# medium_normal_data.py
import random
import csv
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Parameters
m, b = 2, 5
data = []

# Generate 50 data points
for i in range(50):
    x = i * 0.5  # 0, 0.5, 1.0, ... 24.5
    y = m * x + b + random.uniform(-0.8, 0.8)  # random noise
    data.append((x, y))

# Save to CSV
with open("medium_normal_data.csv", "w", newline="") as f:
    writer = csv.writer(f)
    writer.writerow(["x", "y"])
    writer.writerows(data)

print("Medium normal data saved to medium_normal_data.csv")

# Fit and plot
df = pd.read_csv("medium_normal_data.csv")
x = df["x"].values
y = df["y"].values
m_fit, b_fit = np.polyfit(x, y, 1)

plt.scatter(x, y, color="blue", label="Data")
plt.plot(x, m_fit*x + b_fit, color="red", label="Best Fit Line")
plt.plot(x, 2*x + 5, "--", color="green", label="True Line")
plt.legend()
plt.title("Medium Sized Plot (50 Points)")
plt.xlabel("x")
plt.ylabel("y")
plt.savefig("medium_normal_plot.png")
plt.show()

print("Medium normal plot saved as medium_normal_plot.png")
